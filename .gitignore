# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Secrets (never commit the PAT)
.env
*.token
.git-credentials

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
.claude/settings.local.json

# Data: never commit real IBA data. examples/ holds local-only inputs.
*.xnra
*.txt
!prompt_outputs/*.txt
examples/*
!examples/README.md
tests/golden/reference.json
!requirements.txt

# Generated outputs
*.pdf
!docs/**/*.pdf
# Word export of docs/*.md -- built locally, see docs/latex/README.md
*.docx
~$*.docx

# Earlier review reports and diffs: a local archive, not migrated. New
# reports go to the committed prompt_outputs/; see CLAUDE.md rule 12.
reviews/

# Reference documents: local until their authors approve publication.
# Must come after !docs/**/*.pdf above -- last matching rule wins.
docs/references/*
!docs/references/README.md
